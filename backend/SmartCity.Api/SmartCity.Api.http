@SmartCity.Api_HostAddress = http://localhost:5113
@latitude = 41.04
@longitude = 29.01

# Health

GET {{SmartCity.Api_HostAddress}}/health/live

###

GET {{SmartCity.Api_HostAddress}}/health/ready

###

# OpenStreetMap import

POST {{SmartCity.Api_HostAddress}}/api/import/openstreetmap
Accept: application/json

###

# Spatial data

GET {{SmartCity.Api_HostAddress}}/api/map/config
Accept: application/json

###

GET {{SmartCity.Api_HostAddress}}/api/hospitals
Accept: application/json

###

GET {{SmartCity.Api_HostAddress}}/api/fire-stations
Accept: application/json

###

GET {{SmartCity.Api_HostAddress}}/api/roads
Accept: application/json

###

# Spatial analysis

GET {{SmartCity.Api_HostAddress}}/api/location-analysis/nearest?latitude={{latitude}}&longitude={{longitude}}
Accept: application/json

###

GET {{SmartCity.Api_HostAddress}}/api/location-analysis/coverage?latitude={{latitude}}&longitude={{longitude}}
Accept: application/json

###

GET {{SmartCity.Api_HostAddress}}/api/location-analysis/accessibility?latitude={{latitude}}&longitude={{longitude}}
Accept: application/json

###

GET {{SmartCity.Api_HostAddress}}/api/location-analysis/incident-priority?latitude={{latitude}}&longitude={{longitude}}&incidentType=Fire
Accept: application/json

###

# Incidents

POST {{SmartCity.Api_HostAddress}}/api/incidents
Content-Type: application/json
Accept: application/json

{
  "type": "Fire",
  "latitude": {{latitude}},
  "longitude": {{longitude}},
  "description": "Warehouse fire"
}

###

GET {{SmartCity.Api_HostAddress}}/api/incidents
Accept: application/json

###

# Dashboard

GET {{SmartCity.Api_HostAddress}}/api/dashboard/summary
Accept: application/json
